DATABASE_URL="postgresql://hris:hris_dev_password@localhost:5432/hris?schema=public"

PORT=5000
DATABASE_SSL=false
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Buat nilai acak, mis.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Access token berumur pendek; sesi diperpanjang lewat refresh token
# (cookie httpOnly, dirotasi setiap kali dipakai).
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
